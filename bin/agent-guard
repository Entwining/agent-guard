#!/bin/bash -p
# PreToolUse entry for the agent guard:
#   agent-guard --runtime claude|codex|pi < event.json
fail() {
    printf '%s\n' "The agent guard could not complete its check ($1), so this call is blocked. Split the work into smaller calls naming explicit public targets and recheck each call. If a single public-file call still fails, ask the checker owner to run agent-guard --version and repair the reported fault before rechecking the call." >&2
    exit 2
}

[[ $HOME == /* ]] || fail 'HOME is not an absolute path'
entry=$(/bin/realpath "$0") || fail 'entry path unreadable'
pkg=${entry%/*}
pkg=${pkg%/*}
runner=$pkg/bin/agent-guard-native
[[ -x $runner ]] || fail 'native runner missing'
if [[ $# == 1 && $1 == --version ]]; then
    exec "$runner" --version
fi
# The package owns the native executable; the hook directory owns relative targets.
hook_cwd=$PWD
cd "$pkg" || fail 'package directory unreadable'

# The runner makes itself the leader of group $pid before it starts any child and
# kills that group at the three-second deadline. Bash job control would race its
# own setpgid calls, and without it a shell watchdog could not be reaped as a group.
# Explicit stdin prevents Bash 3.2 from nulling background input in this substitution.
reason=$(
    "$runner" "$@" --cwd "$hook_cwd" <&0 2>&1 &
    pid=$!
    wait "$pid" 2>/dev/null
    rc=$?
    kill -KILL -- -"$pid" 2>/dev/null
    exit "$rc"
) 2>/dev/null
rc=$?
# Rust maps checker rejection 2 to runner status 3; faults and panics stay nonzero.
case $rc in
    (0) [[ -n $reason ]] && printf '%s\n' "$reason"; exit 0 ;;
    (3) ;;
    (*) fail 'guard failed' ;;
esac
[[ -n $reason ]] || fail 'guard gave no reason'
printf '%s\n' "$reason" >&2
exit 2
