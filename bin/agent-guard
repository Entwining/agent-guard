#!/bin/bash -p
# PreToolUse entry for the agent guard:
#   agent-guard --runtime claude|codex|pi < event.json
# Runs the Bun runner from the package directory and passes denials through
# with exit 2. Exit 0 only means no objection; it never approves a call. Every
# other outcome denies too, because Claude lets a hook's other failures and
# timeouts through, Codex is assumed to, and nothing else stands between an
# agent and ~/Library.
fail() {
    printf '%s\n' "The agent guard could not complete its check ($1), so this call is blocked. Inspect the guard installation, repair the reported failure, then retry the call." >&2
    exit 2
}

[[ $HOME == /* ]] || fail 'HOME is not an absolute path'
entry=$(/bin/realpath "$0") || fail 'entry path unreadable'
pkg=${entry%/*}
pkg=${pkg%/*}
bun=$(command -v bun) || fail 'bun missing'
guard=$pkg/src/guard.ts
[[ -r $guard ]] || fail 'guard.ts missing'
runner=$pkg/src/runner.ts
[[ -r $runner ]] || fail 'runner.ts missing'
[[ -r $pkg/tsconfig.json ]] || fail 'tsconfig.json missing'
event=$(/bin/cat)
# Bun reads bunfig.toml and environment files from its working directory;
# the package config owns TypeScript paths. Pass the hook's directory as --cwd.
hook_cwd=$PWD
cd "$pkg" || fail 'package directory unreadable'

# Bash job control establishes the job's group before exec, even without a TTY.
# A single background command has PID = PGID; ordinary descendants inherit it.
# Process substitution keeps Bun as the job leader and the event in a pipe.
reason=$(
    set -m
    "$bun" "$runner" "$@" --cwd "$hook_cwd" < <(printf '%s\n' "$event") 2>&1 &
    pid=$!
    { /bin/sleep 3; kill -KILL -- -"$pid"; } >/dev/null 2>&1 &
    watchdog=$!
    wait "$pid" 2>/dev/null
    rc=$?
    kill -KILL -- -"$pid" 2>/dev/null
    kill -KILL -- -"$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
    exit "$rc"
) 2>/dev/null
rc=$?
case $rc in
    (0) [[ -n $reason ]] && printf '%s\n' "$reason"; exit 0 ;;
    (2) ;;
    (*) fail 'guard failed' ;;
esac
[[ -n $reason ]] || fail 'guard gave no reason'
printf '%s\n' "$reason" >&2
exit 2
